{
  "name": "epohi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "demo": "node --experimental-strip-types --no-warnings src/demo.ts",
    "server": "node --experimental-strip-types --no-warnings server/server.ts",
    "predev": "node scripts/fetch-assets.mjs --if-missing",
