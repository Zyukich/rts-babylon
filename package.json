    "typecheck": "tsc -p .",
    "test": "npm run typecheck && npm run demo"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "ws": "^8.18.0",
    "@babylonjs/loaders": "^8.0.0",
    "@babylonjs/materials": "^8.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "typescript": "^5.6.0",
    "@types/ws": "^8.5.0",
    "fflate": "^0.8.2"
  }
}
